# pantr CMake package.
#
#   find_package(pantr [<version>] [COMPONENTS mpi | mpi-capsule | berf | metis])
#
# Targets: pantr::pantr (always, unless only mpi-capsule is requested), pantr::mpi_capsule,
# pantr::mpi (component mpi), pantr::metis (component metis, which needs the user's METIS). Set
# PANTR_NATIVE_ARCH to OFF before find_package to build without the native-ISA flag (default ON).
# The Python wheel's copy of this package carries no third-party headers and offers mpi-capsule
# only.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# A build that asks only for the MPI capsule ABI (the pantr-mpi extension) must not need the
# third-party headers, which an installed Python wheel does not carry.
set(_pantr_capsule_only FALSE)
if(pantr_FIND_COMPONENTS STREQUAL "mpi-capsule")
  set(_pantr_capsule_only TRUE)
endif()

# The Python wheel's package (pantr.cmake_dir()) has pantr's headers but not the bundled
# third-party ones, so it offers mpi-capsule alone: refuse the rest here, by name, rather than
# with a compile error in the consumer.
if(NOT _pantr_capsule_only AND NOT EXISTS "@PACKAGE_PANTR_INSTALL_THIRD_PARTY_DIR@")
  set(pantr_FOUND FALSE)
  string(CONCAT pantr_NOT_FOUND_MESSAGE
      "this pantr (${CMAKE_CURRENT_LIST_DIR}) has pantr's headers but not the third-party headers "
      "pantr::pantr needs (Eigen, Spectra, Kokkos mdspan, Boost.Multiprecision and Boost.Config), "
      "as in the Python wheel's package, which provides COMPONENTS mpi-capsule only. For "
      "pantr::pantr, use a pantr installed with CMake (cmake --install), which bundles them.")
  return()
endif()

if(NOT _pantr_capsule_only)
  find_dependency(Threads)
  include("${CMAKE_CURRENT_LIST_DIR}/pantrTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/PantrNativeArch.cmake")
  # Imported targets are directory-scoped, so each find_package call in another directory gets a
  # fresh pantr::pantr; mark the target itself rather than the global scope.
  get_target_property(_pantr_flags_applied pantr::pantr PANTR_CONSUMER_FLAGS_APPLIED)
  if(NOT _pantr_flags_applied)
    set_target_properties(pantr::pantr PROPERTIES PANTR_CONSUMER_FLAGS_APPLIED TRUE)
    if(NOT DEFINED PANTR_NATIVE_ARCH)
      set(PANTR_NATIVE_ARCH ON)
    endif()
    pantr_apply_native_arch(pantr::pantr "${PANTR_NATIVE_ARCH}")
    pantr_report_fp_contract("@PANTR_FP_CONTRACT@")
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/pantrMpiCapsuleTargets.cmake")

foreach(_pantr_comp IN LISTS pantr_FIND_COMPONENTS)
  if(_pantr_comp STREQUAL "mpi-capsule")
    set(pantr_mpi-capsule_FOUND TRUE)
  elseif(_pantr_comp STREQUAL "mpi")
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pantrMpiTargets.cmake")
      find_dependency(MPI COMPONENTS CXX)
      include("${CMAKE_CURRENT_LIST_DIR}/pantrMpiTargets.cmake")
      set(pantr_mpi_FOUND TRUE)
    else()
      set(pantr_mpi_FOUND FALSE)
      set(pantr_NOT_FOUND_MESSAGE "pantr was installed without MPI, so component mpi is absent")
    endif()
  elseif(_pantr_comp STREQUAL "metis")
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/pantrMetisTargets.cmake")
      # FindMETIS.cmake ships beside this file; the consumer's module path is restored after.
      set(_pantr_saved_module_path "${CMAKE_MODULE_PATH}")
      list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
      find_dependency(METIS)
      set(CMAKE_MODULE_PATH "${_pantr_saved_module_path}")
      include("${CMAKE_CURRENT_LIST_DIR}/pantrMetisTargets.cmake")
      set(pantr_metis_FOUND TRUE)
    else()
      set(pantr_metis_FOUND FALSE)
      set(pantr_NOT_FOUND_MESSAGE "pantr was installed without METIS, so component metis is absent")
    endif()
  elseif(_pantr_comp STREQUAL "berf")
    set(pantr_${_pantr_comp}_FOUND FALSE)
    set(pantr_NOT_FOUND_MESSAGE "pantr component ${_pantr_comp} is not part of this version")
  else()
    set(pantr_${_pantr_comp}_FOUND FALSE)
    set(pantr_NOT_FOUND_MESSAGE "unknown pantr component '${_pantr_comp}'")
  endif()
endforeach()

check_required_components(pantr)
