# Fail if any header under INCLUDE_DIR other than ALLOWED mentions mpi.h in an #include.
file(GLOB_RECURSE headers RELATIVE "${INCLUDE_DIR}" "${INCLUDE_DIR}/pantr/*.hpp" "${INCLUDE_DIR}/pantr/*.h")
set(offenders "")
foreach(h IN LISTS headers)
  if(h STREQUAL ALLOWED)
    continue()
  endif()
  file(STRINGS "${INCLUDE_DIR}/${h}" hits REGEX "#[ \t]*include[ \t]*[<\"]mpi\\.h[>\"]")
  if(hits)
    list(APPEND offenders "${h}")
  endif()
endforeach()
list(LENGTH headers n)
if(n EQUAL 0)
  message(FATAL_ERROR "no headers found under ${INCLUDE_DIR}: the check would pass vacuously")
endif()
if(offenders)
  message(FATAL_ERROR "headers including mpi.h: ${offenders}")
endif()
message(STATUS "checked ${n} headers: none includes mpi.h")
