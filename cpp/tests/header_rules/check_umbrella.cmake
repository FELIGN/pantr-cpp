# Fail unless include/pantr/pantr.hpp includes every header under include/pantr outside detail/ and
# mpi/ (the pantr::mpi component), itself excepted: the umbrella's documented contract.
cmake_minimum_required(VERSION 3.28)
file(GLOB_RECURSE headers RELATIVE "${INCLUDE_DIR}" "${INCLUDE_DIR}/pantr/*.hpp")
file(READ "${INCLUDE_DIR}/pantr/pantr.hpp" umbrella)
set(n 0)
set(missing "")
foreach(h IN LISTS headers)
  if(h MATCHES "/detail/" OR h MATCHES "^pantr/mpi/" OR h STREQUAL "pantr/pantr.hpp")
    continue()
  endif()
  math(EXPR n "${n} + 1")
  string(FIND "${umbrella}" "#include \"${h}\"" pos)
  if(pos EQUAL -1)
    list(APPEND missing "${h}")
  endif()
endforeach()
if(n EQUAL 0)
  message(FATAL_ERROR "no public header found under ${INCLUDE_DIR}: the check would pass vacuously")
endif()
if(missing)
  list(JOIN missing "\n  " missing_lines)
  message(FATAL_ERROR "pantr/pantr.hpp does not include:\n  ${missing_lines}")
endif()
message(STATUS "pantr/pantr.hpp includes all ${n} public headers")
