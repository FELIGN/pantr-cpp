# Fail unless every commit pinned in DEPS_FILE (a GIT_TAG of 40 hex digits) appears in NOTICES_FILE,
# so the third-party listing cannot drift from the pins.
file(STRINGS "${DEPS_FILE}" tags REGEX "GIT_TAG [0-9a-f]+")
file(READ "${NOTICES_FILE}" notices)
set(n 0)
foreach(line IN LISTS tags)
  if(NOT line MATCHES "GIT_TAG ([0-9a-f]+)")
    continue()
  endif()
  set(sha "${CMAKE_MATCH_1}")
  string(LENGTH "${sha}" len)
  if(NOT len EQUAL 40)
    message(FATAL_ERROR "pin is not a full commit SHA: ${line}")
  endif()
  string(FIND "${notices}" "${sha}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "pinned commit ${sha} is missing from ${NOTICES_FILE}")
  endif()
  math(EXPR n "${n} + 1")
endforeach()
if(n EQUAL 0)
  message(FATAL_ERROR "no GIT_TAG pins found in ${DEPS_FILE}: the check would pass vacuously")
endif()
file(STRINGS "${DEPS_FILE}" all_tags REGEX "GIT_TAG")
list(LENGTH all_tags n_all)
if(NOT n_all EQUAL n)
  message(FATAL_ERROR "${DEPS_FILE} has ${n_all} GIT_TAG lines but only ${n} are commit SHAs")
endif()
message(STATUS "${n} pinned commits, all listed in the notices")
