"""What pantr-mpi's extension was built against (generated by CMake; do not edit).

Read by :mod:`pantr.mpi` before it imports the extension, so a mismatched or missing MPI
library is reported by name rather than by a loader error.
"""

FAMILY: str = "@_pantr_mpi_family@"
"""str: ``"openmpi"``, ``"mpich"`` (the MPICH ABI) or ``"custom"`` (no check)."""

BUILT_AGAINST: str = "@_pantr_mpi_version_py@"
"""str: The first line of the MPI library version string at build time."""
